{
  "kind": "collectionType",
  "collectionName": "heroes",
  "info": {
    "singularName": "hero",
    "pluralName": "heroes",
    "displayName": "Hero"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "url": {
      "type": "string"
    },
    "releaseDate": {
      "type": "date"
    },
    "role": {
      "type": "enumeration",
      "default": "Main Carry",
      "enum": [
        "Main Carry",
        "Off Carry",
        "Front Line",
        "Initiator",
        "Assassin",
        "Off Support",
        "Main Support"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
